{
  "name": "toolpayload",
  "version": "0.1.0",
  "description": "Offline MCP tool-result size budgets, field attribution, and CI reports.",
  "type": "module",
  "bin": {
    "toolpayload": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "docs/RESEARCH.md",
    "docs/assets/report-preview.png",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "agent",
    "context",
    "budget",
    "cli"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node scripts/browser-smoke.mjs",
    "demo": "node scripts/demo.mjs",
    "smoke": "node scripts/smoke.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "js-tiktoken": "^1.0.21"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "playwright": "^1.56.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudwallker/toolpayload.git"
  },
  "homepage": "https://github.com/cloudwallker/toolpayload#readme",
  "bugs": {
    "url": "https://github.com/cloudwallker/toolpayload/issues"
  }
}
